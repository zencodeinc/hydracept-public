<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Hydracept.Client</RootNamespace>
    <AssemblyName>Hydracept.Client</AssemblyName>
    <Description>Thin HTTP + SSE client for the Hydracept public API — production-ready game assets, with a receipt for every run.</Description>
    <Version>0.3.2</Version>
    <Authors>Zencode</Authors>
    <PackageId>Hydracept.Client</PackageId>
    <PackageTags>hydracept;mcp;gamedev;unity;image-generation;sprite-sheet;transparent-png;reference-image;multi-provider;game-ai</PackageTags>
    <PackageProjectUrl>https://hydracept.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zencodeinc/hydracept-public</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
      <PackageReference Include="System.Net.Http.Json" Version="8.0.1" />
    </ItemGroup>

</Project>
