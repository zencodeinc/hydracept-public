<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Hydracept.Client</RootNamespace>
    <AssemblyName>Hydracept.Client</AssemblyName>
    <Description>Thin HTTP + SSE client for the Hydracept public API — execution control plane for software and agents, with a receipt for every run.</Description>
    <Version>0.5.4</Version>
    <Authors>Zencode</Authors>
    <PackageId>Hydracept.Client</PackageId>
    <PackageTags>hydracept;ai-agent-infrastructure;agent-execution;ai-execution;mcp;agent-tools;ai-capabilities;multi-provider;durable-jobs;byok;receipts;image-generation;video-generation;audio-generation;3d-generation;game-assets;unity;sprite-sheet;transparent-png;reference-image;gamedev;game-ai</PackageTags>
    <PackageProjectUrl>https://hydracept.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zencodeinc/hydracept-public</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SourceLinkCreate>false</SourceLinkCreate>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hydracept.Client.Tests" />
  </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
      <PackageReference Include="System.Net.Http.Json" Version="8.0.1" />
    </ItemGroup>

</Project>
