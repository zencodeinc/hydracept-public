{
  "name": "@hydracept/sdk",
  "version": "0.5.3",
  "description": "TypeScript SDK for Hydracept — durable AI capability execution for software and agents, with multi-provider routing, budgets, artifacts, and receipts.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "hydracept",
    "ai-agent-infrastructure",
    "agent-execution",
    "ai-execution",
    "mcp",
    "agent-tools",
    "ai-capabilities",
    "multi-provider",
    "durable-jobs",
    "byok",
    "receipts",
    "image-generation",
    "video-generation",
    "audio-generation",
    "3d-generation",
    "game-assets",
    "unity",
    "sprite-sheet",
    "transparent-png",
    "reference-image",
    "gamedev",
    "game-ai",
    "unreal",
    "api",
    "sdk"
  ],
  "license": "MIT",
  "homepage": "https://hydracept.com",
  "bugs": {
    "url": "https://github.com/zencodeinc/hydracept-public/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zencodeinc/hydracept-public.git",
    "directory": "clients/typescript"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
